# Copia este fichero a .env y rellena la clave (una sola para los dos modelos).
# Si la dejas vacía, la interfaz te la pedirá al abrir la demo.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.tools.gplsi.es
CLASIFICADOR_MODEL=Aitana-euipo-absolute-refusals-1.0
GENERADOR_MODEL=EUIPO_Aitana_2B_S_Instruct_absolute_refusals_v1

# Solo para docker compose
TEST_JSONL=../test.jsonl
PREDICCIONES_JSONL=../predictions.jsonl
PUERTO=8000
OPCIONES=
